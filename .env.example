# --- Application ---
APP_NAME=Majlis TV
API_PORT=3000
CORS_ORIGIN=http://localhost:3001

# --- Base de données (mot de passe alphanumérique recommandé) ---
POSTGRES_DB=majlis
POSTGRES_USER=majlis
POSTGRES_PASSWORD=CHANGER_MOI

# --- Sécurité : générer avec  openssl rand -hex 32 ---
JWT_SECRET=CHANGER_MOI_PAR_UNE_CHAINE_DE_64_CARACTERES_MINIMUM_0000
JWT_EXPIRES=7d

# Proxys de confiance devant l'API : sert à connaître la vraie adresse IP du visiteur, qui est la clé
# des limites de débit (protection contre les essais de mots de passe en série sur /auth/login).
# Laisser vide : l'API fait confiance au nginx local uniquement, ce qui est le réglage du serveur.
# À remplir seulement si l'API passe un jour derrière un proxy distant (CDN) : ses adresses IP, séparées
# par des virgules. Ne jamais mettre « true » ou un nombre ici.
# TRUST_PROXY=

# --- Chiffrement des clés enregistrées dans le back-office (Admin → Paramètres) ---
# Générer UNE fois avec  openssl rand -hex 32  puis mettre la MÊME valeur sur api, translator et transcriber.
# Ne jamais la changer ensuite (les clés déjà enregistrées deviendraient illisibles : il faudrait les ressaisir).
SETTINGS_KEY=CHANGER_MOI_PAR_UNE_CHAINE_DE_64_CARACTERES_MINIMUM_1111

# --- Compte administrateur créé au 1er démarrage (optionnel) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGER_MOI_MOT_DE_PASSE_LONG

# --- Stripe, IA, Whisper : se règlent désormais dans le site (Admin → Paramètres). ---
# Les variables ci-dessous restent acceptées comme valeur de secours (la valeur du back-office est prioritaire).
# WEB_URL=https://majlisstv.le-publicitaire.fr      # adresse publique du site (retour après paiement)
# STRIPE_SECRET_KEY=sk_test_REMPLACER                # clé secrète (sk_test_… pour tester, sk_live_… en production)
# STRIPE_WEBHOOK_SECRET=whsec_REMPLACER              # secret de signature du webhook
# STRIPE_PRICE_MONTHLY=price_REMPLACER               # identifiant du prix mensuel
# STRIPE_PRICE_YEARLY=price_REMPLACER                # identifiant du prix annuel
# TRIAL_DAYS=7                                       # essai gratuit (0 = aucun)
# PREVIEW_SECONDS=120                                # aperçu gratuit des conférences premium

# --- Recherche Meilisearch (étape 7) : clé maître du service majlistv-search (openssl rand -hex 32) ---
# Adresse et clé se saisissent ensuite dans Admin → Paramètres → Recherche.
MEILI_MASTER_KEY=CHANGER_MOI_PAR_UNE_CHAINE_DE_64_CARACTERES_MINIMUM_2222

# --- E-mails (étape 9) : à régler de préférence dans Admin → Paramètres → E-mails ---
# SMTP_HOST=smtp-relay.exemple.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=Mejliss TV <noreply@votre-domaine.fr>

