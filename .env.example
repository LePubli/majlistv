# --- Application ---
APP_NAME=Majlis TV
API_PORT=3000
CORS_ORIGIN=http://localhost:3001

# --- Base de données (mot de passe alphanumérique recommandé) ---
POSTGRES_DB=majlis
POSTGRES_USER=majlis
POSTGRES_PASSWORD=CHANGER_MOI

# --- Sécurité : générer avec  openssl rand -hex 32 ---
JWT_SECRET=CHANGER_MOI_PAR_UNE_CHAINE_DE_64_CARACTERES_MINIMUM_0000
JWT_EXPIRES=7d

# --- Compte administrateur créé au 1er démarrage (optionnel) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGER_MOI_MOT_DE_PASSE_LONG

# --- Abonnements Stripe (étape 4) : laisser vide tant que Stripe n'est pas configuré ---
# WEB_URL=https://majlisstv.le-publicitaire.fr      # adresse publique du site (retour après paiement)
# STRIPE_SECRET_KEY=sk_test_REMPLACER                # clé secrète (sk_test_… pour tester, sk_live_… en production)
# STRIPE_WEBHOOK_SECRET=whsec_REMPLACER              # secret de signature du webhook
# STRIPE_PRICE_MONTHLY=price_REMPLACER               # identifiant du prix mensuel
# STRIPE_PRICE_YEARLY=price_REMPLACER                # identifiant du prix annuel
# TRIAL_DAYS=7                                       # essai gratuit (0 = aucun)
# PREVIEW_SECONDS=120                                # aperçu gratuit des conférences premium

