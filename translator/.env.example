# Variables du service de traduction (à saisir dans DockPanel, jamais dans Git)
DATABASE_URL=postgres://utilisateur:motdepasse@172.17.0.1:5432/appmajlistv

# Moteur par défaut : claude (meilleure qualité) | azure (quota gratuit 2 M caractères/mois) | deepseek (très économique)
TRANSLATE_PROVIDER=claude

# --- Moteur Claude (obligatoire si TRANSLATE_PROVIDER=claude, ou si TRANSLATE_CLAUDE_LANGS est rempli)
ANTHROPIC_API_KEY=sk-ant-REMPLACER
CLAUDE_MODEL=claude-haiku-5-5

# --- Moteur Azure AI Translator (obligatoire si TRANSLATE_PROVIDER=azure)
# AZURE_TRANSLATOR_KEY=REMPLACER
# AZURE_TRANSLATOR_REGION=francecentral
# AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
# --- Moteur DeepSeek (obligatoire si TRANSLATE_PROVIDER=deepseek ou TRANSLATE_DEEPSEEK_LANGS rempli)
# DEEPSEEK_API_KEY=REMPLACER
# DEEPSEEK_MODEL=deepseek-flash
# Mode hybride : langues cibles forcées vers un moteur précis, quel que soit le moteur par défaut
# TRANSLATE_CLAUDE_LANGS=ar
# TRANSLATE_AZURE_LANGS=
# TRANSLATE_DEEPSEEK_LANGS=
# Débit maximal envoyé à Azure (limite F0 : 33 300 car./min), 0 = aucune limite
# AZURE_CHARS_PER_MINUTE=30000

# --- Résumé + chapitres (étape 3D) : actifs automatiquement si DEEPSEEK_API_KEY ou ANTHROPIC_API_KEY existe
# INSIGHTS_PROVIDER=deepseek      # deepseek | claude (défaut : deepseek s'il a une clé, sinon claude)
# INSIGHTS_ENABLED=on             # off pour désactiver
# INSIGHTS_CLAUDE_MODEL=claude-haiku-5-5
# INSIGHTS_MAX_CHARS=200000       # garde-fou : transcription plus longue refusée

# Optionnel
# TRANSLATE_CHUNK_SEGMENTS=40
# TRANSLATE_MAX_CHARS=600000
# POLL_SECONDS=10
