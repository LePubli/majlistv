{
  "expo": {
    "name": "Mejliss TV",
    "slug": "majlistv",
    "scheme": "mejlisstv",
    "version": "0.13.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0906",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "fr.lepublicitaire.mejlisstv",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio"
        ],
        "NSBonjourServices": [
          "_googlecast._tcp",
          "_CC1AD845._googlecast._tcp"
        ],
        "NSLocalNetworkUsageDescription": "Mejliss TV cherche les téléviseurs et enceintes du réseau pour y diffuser la vidéo."
      }
    },
    "android": {
      "package": "fr.lepublicitaire.mejlisstv",
      "versionCode": 10,
      "supportsRtl": true,
      "adaptiveIcon": {
        "backgroundColor": "#0B0906",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ],
      "allowBackup": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-notifications",
        {
          "color": "#E6A739",
          "defaultChannel": "news"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Mejliss TV utilise votre position approximative, seulement quand vous le demandez, pour calculer les horaires de prière.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B0906"
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false,
            "enableMinifyInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false
          }
        }
      ],
      [
        "react-native-google-cast",
        {
          "receiverAppId": "CC1AD845",
          "expandedController": false,
          "iosStartDiscoveryAfterFirstTapOnCastButton": true,
          "androidPlayServicesCastFrameworkVersion": "22.3.1"
        }
      ],
      "expo-system-ui"
    ],
    "extra": {
      "apiUrl": "https://api-majlisstv.le-publicitaire.fr",
      "siteUrl": "https://majlisstv.le-publicitaire.fr"
    },
    "updates": {
      "url": "https://api-majlisstv.le-publicitaire.fr/app/updates/manifest",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
